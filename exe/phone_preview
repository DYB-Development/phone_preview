#!/usr/bin/env ruby
require "rqrcode"
require "yaml"

def stop(message)
  warn "phone_preview: #{message}"
  exit 1
end

def installed?(command)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? { |dir| File.executable?(File.join(dir, command)) }
end

stop "ngrok is not installed. Install it with `brew install ngrok`." unless installed?("ngrok")

def signed_in?
  return true if ENV["NGROK_AUTHTOKEN"].to_s != ""

  config = IO.popen(%w[ngrok config check], err: File::NULL, &:read)[/Valid configuration file at (.+)$/, 1]
  config && File.exist?(config) && YAML.safe_load_file(config).to_h.then { |settings| settings.dig("agent", "authtoken") || settings["authtoken"] }.to_s != ""
end

stop "ngrok is not signed in to an account. Sign in with `ngrok config add-authtoken <token>`." unless signed_in?

address = ENV.fetch("PUBLIC_BASE_URL")
ENV["PORT"] ||= "3000"

puts RQRCode::QRCode.new(address).as_ansi
puts "Open #{address} on your phone"

procfile = File.expand_path("../lib/phone_preview/Procfile", __dir__)
$stdout.flush
exec "overmind", "start", "-T", "--no-port", "-f", procfile, "-d", Dir.pwd
