#!/usr/bin/env ruby
require "rqrcode"

address = ENV.fetch("PUBLIC_BASE_URL")
ENV["PORT"] ||= "3000"

puts RQRCode::QRCode.new(address).as_ansi
puts "Open #{address} on your phone"

procfile = File.expand_path("../lib/phone_preview/Procfile", __dir__)
$stdout.flush
exec "overmind", "start", "-T", "--no-port", "-f", procfile, "-d", Dir.pwd
